            assert_eq!(Some(r.kind.to_u16()), r.kind.frost_moon_type());
            assert_eq!(NpcKind::moon_wave_kind(ty), Some(r.kind), "{:?} wave map", r.kind);
            let slots = crate::spawner::moon_boss_slots(ty);
            match r.kind {
                NpcKind::Everscream => assert_eq!(slots, Some(3.0)),
