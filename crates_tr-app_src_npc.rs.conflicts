    #[test]
    fn s1_f_13c_the_moon_wave_kind_map_decodes_the_frost_band() {
        for r in rows().iter() {
            assert_eq!(NpcKind::moon_wave_kind(r.ty), Some(r.kind), "{:?}", r.kind);
