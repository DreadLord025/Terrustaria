<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WorldGenParityHarness</RootNamespace>
    <!-- The decompile is C# 14-flavoured (field-backed properties etc.). -->
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0649;CS0169;CS0414;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reuse the S1-J-3 save path verbatim: every Generated save body + every
         shim EXCEPT Ids.cs (this harness needs the worldgen TileID sets too,
         so it ships its own superset) and Program.cs (the fixture driver). -->
    <Compile Include="../WldFixtureHarness/Generated/*.cs" />
    <Compile Include="../WldFixtureHarness/Shims/*.cs" Exclude="../WldFixtureHarness/Shims/Ids.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\decompiled\Terraria.Libraries.JSON.NET.Newtonsoft.Json.dll</HintPath>
    </Reference>
    <PackageReference Include="System.Security.Permissions" Version="8.0.0" />
  </ItemGroup>
</Project>
