<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MapDeflateHarness</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The FW 4.8 generator is compiled separately with the in-box csc.exe
         (see fw48/MapDeflateFw48.cs) — it is not part of this project. -->
    <Compile Remove="fw48\**" />
  </ItemGroup>
</Project>
