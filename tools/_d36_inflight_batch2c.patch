+        assert_eq!(kind.contact_damage(), 65, "damage (`:15429`)");
+        assert_eq!(shell.defense(), 18, "defense (`:15430`)");
+        assert_eq!(kind.max_hp(), 350, "lifeMax (`:15431`)");
