<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WldFixtureHarness</RootNamespace>
    <!-- The decompile is C# 14-flavoured (field-backed properties etc.). -->
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0649;CS0169;CS0414;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\decompiled\Terraria.Libraries.JSON.NET.Newtonsoft.Json.dll</HintPath>
    </Reference>
    <!-- The retail Newtonsoft build probes System.Security.Permissions for
         DynamicCodeGeneration; the NuGet facade satisfies the probe. -->
    <PackageReference Include="System.Security.Permissions" Version="8.0.0" />
  </ItemGroup>
</Project>